# NeuroFriend Local LLM Bridge configuration
# Быстрая интерактивная настройка: npm run llm:setup

# Адрес и порт локального моста (к нему подключается приложение)
CHAT_SERVER_HOST=0.0.0.0
CHAT_SERVER_PORT=3001

# Опциональный Bearer-токен для защиты моста (пусто = без токена в локальной сети)
CHAT_SERVER_API_KEY=

# Провайдер локальной LLM: auto | ollama | openai
LLM_PROVIDER=auto

# URL вашей локальной LLM (пусто = автопоиск Ollama / LM Studio / llama.cpp / vLLM / MLX / Jan)
LLM_BASE_URL=

# Имя модели (пусто = автовыбор загруженной/установленной модели)
LLM_MODEL=

# Опциональный API-ключ для самой LLM
LLM_API_KEY=

# Параметры генерации
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1536
LLM_TIMEOUT_MS=120000
# Инструкция длины/стиля ответа (если закомментировано — по умолчанию 5–15 предложений; off — отключить)
# LLM_SYSTEM_APPEND=

# Настройки только для Ollama
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false

# Автоматический обратный SSH-туннель на ваш Debian VPS (LLM работает на Windows, а Debian раздаёт в интернет 24/7)
# Пример:
#   VPS_SSH_TARGET=root@1.2.3.4
#   VPS_SSH_PORT=22
#   VPS_SSH_KEY=C:\Users\dzinn\.ssh\id_ed25519
#   VPS_REMOTE_PORT=3001
#   VPS_PUBLIC_URL=https://ai.yourdomain.ru
VPS_SSH_TARGET=
VPS_SSH_PORT=22
VPS_SSH_KEY=
VPS_REMOTE_PORT=3001
VPS_PUBLIC_URL=

# Доступ вне локальной сети через Tailscale:
#   ENABLE_TAILSCALE_FUNNEL=true — публичный HTTPS (https://<имя>.ts.net/chat), работает с телефона БЕЗ приложения Tailscale
#   ENABLE_TAILSCALE_SERVE=true  — приватный HTTPS (только для устройств с включённым Tailscale)
ENABLE_TAILSCALE_SERVE=false
ENABLE_TAILSCALE_FUNNEL=true

# Альтернативный публичный SSH-туннель (localhost.run): true | false
ENABLE_PUBLIC_TUNNEL=false
