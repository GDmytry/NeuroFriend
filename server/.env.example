# NeuroFriend Local LLM Bridge configuration
# Быстрая интерактивная настройка: npm run llm:setup

# Адрес и порт локального моста (к нему подключается приложение)
CHAT_SERVER_HOST=0.0.0.0
CHAT_SERVER_PORT=3001

# Опциональный Bearer-токен для защиты моста.
# Оставьте пустым для быстрого локального запуска на ПК / в домашнем Wi-Fi.
# Если открываете доступ в интернет (туннель), обязательно задайте длинный случайный ключ.
CHAT_SERVER_API_KEY=

# Провайдер локальной LLM: auto | ollama | openai
#   auto   — автоопределение (Ollama / LM Studio / llama.cpp / vLLM / MLX / Jan)
#   ollama — Ollama API (/api/chat)
#   openai — любой OpenAI-совместимый сервер (/v1/chat/completions)
LLM_PROVIDER=auto

# URL вашей локальной LLM.
# Оставьте пустым — мост сам найдёт запущенную LLM на стандартных портах:
#   Ollama:    http://127.0.0.1:11434
#   LM Studio: http://127.0.0.1:1234
#   llama.cpp: http://127.0.0.1:8080
#   vLLM/MLX:  http://127.0.0.1:8000
#   Jan:       http://127.0.0.1:1337
#   KoboldCPP: http://127.0.0.1:5000
LLM_BASE_URL=

# Имя модели (оставьте пустым для автовыбора первой доступной/загруженной модели)
LLM_MODEL=

# Опциональный API-ключ для самой LLM (если ваш сервер требует ключ)
LLM_API_KEY=

# Параметры генерации
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1536
LLM_TIMEOUT_MS=120000
# Инструкция длины/стиля ответа (если не задано — по умолчанию 5–15 предложений; off — отключить)
# LLM_SYSTEM_APPEND=

# Настройки только для Ollama
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false

# Автоматический обратный SSH-туннель на ваш Debian VPS (LLM работает на Windows, а Debian раздаёт в интернет)
# Пример:
#   VPS_SSH_TARGET=root@1.2.3.4
#   VPS_SSH_PORT=22
#   VPS_SSH_KEY=C:\Users\dzinn\.ssh\id_ed25519
#   VPS_REMOTE_PORT=3001
#   VPS_PUBLIC_URL=https://ai.yourdomain.ru
VPS_SSH_TARGET=
VPS_SSH_PORT=22
VPS_SSH_KEY=
VPS_REMOTE_PORT=3001
VPS_PUBLIC_URL=

# Доступ вне локальной сети через Tailscale:
#   ENABLE_TAILSCALE_SERVE=true  — приватный HTTPS (https://<имя>.ts.net/chat) для ваших устройств в Tailscale
#   ENABLE_TAILSCALE_FUNNEL=true — публичный HTTPS (работает даже без Tailscale на телефоне; задайте CHAT_SERVER_API_KEY)
ENABLE_TAILSCALE_SERVE=true
ENABLE_TAILSCALE_FUNNEL=false

# Альтернативный публичный SSH-туннель (localhost.run): true | false
ENABLE_PUBLIC_TUNNEL=false
