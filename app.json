{
  "expo": {
    "name": "Neuro Chat",
    "slug": "neuro-chat-mobile",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "splash": {
      "backgroundColor": "#F7F3EC"
    },
    "ios": {
      "bundleIdentifier": "com.codex.neurochat",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Приложению нужен доступ к локальной сети для подключения к вашему LLM-серверу на компьютере.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.codex.neurochat",
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "useMockAi": false,
      "aiApiUrl": "http://192.168.3.145:3001/chat",
      "aiTailscaleUrl": "http://79.98.139.16:3001/chat",
      "aiApiKey": "",
      "eas": {
        "projectId": "0943255e-8d0e-4499-8acb-fa0e4128938f"
      }
    },
    "owner": "dmytrygl"
  }
}
